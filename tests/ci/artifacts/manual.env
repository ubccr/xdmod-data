# This file is for manual testing and is unused by CircleCI.
# See docs/developing.md for manual testing instructions.
# The version of XDMoD against which to run tests. Can be xdmod-main-dev,
# xdmod-[version], or xdmod-[version]-dev, where [version] is the major version
# with dashes instead of dots, e.g., 11-0.
XDMOD_VERSION=xdmod-main-dev

# The name of the Docker container that will run the XDMoD web server and
# database.
CONTAINER_NAME=$XDMOD_VERSION

# The network port on localhost for the XDMoD webserver (bound to 443 in the
# container).
PORT=8080

# The image from which the container will be built.
BASE_IMAGE=tools-ext-01.ccr.xdmod.org/xdmod:x86_64-rockylinux8.9.20231119-v11.0.0-1.0-03

# The path to the Python virtual environment that will be used for testing.
VENV=~/xdmod-data-test-venv
